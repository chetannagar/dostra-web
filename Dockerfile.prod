# Production Dockerfile for the Dostra CRM frontend.
#
# Uses a multi-stage build:
# - Stage 1 (builder): installs dependencies and compiles static assets with Vite
# - Stage 2 (runner): copies only the built files into a minimal Nginx image
#
# Key differences from the dev image:
# - no Vite dev server — Nginx serves the pre-built static files
# - no source code or node_modules in the final image
# - VITE_API_BASE_URL must be set at build time (baked into the JS bundle by Vite)

# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Copy manifests first to cache the npm install layer separately from source.
COPY package.json package-lock.json ./

# Install exact dependencies from the lockfile.
RUN npm ci

# Copy the full source.
COPY . .

# VITE_API_BASE_URL is baked into the JS bundle at build time by Vite.
# Pass it as a build arg so CI/CD can inject the real production API URL.
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# Compile and bundle the frontend for production.
RUN npm run build

# ── Stage 2: serve ────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runner

# Remove the default Nginx placeholder page.
RUN rm -rf /usr/share/nginx/html/*

# Copy the compiled assets from the builder stage.
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy a custom Nginx config that handles SPA client-side routing.
# All unknown paths fall back to index.html so the React router can handle them.
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Nginx listens on port 80 inside the container.
# The docker-compose.prod.yml maps this to the host port.
EXPOSE 80

# Start Nginx in the foreground (required for Docker).
CMD ["nginx", "-g", "daemon off;"]
